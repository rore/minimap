# Normalize line endings for source files. Without this, Windows checkouts with
# core.autocrlf=true convert some files to CRLF on disk, which breaks the
# tri-tree parity test that compares bundled-runtime copies against the
# top-level source via fs.readFile (utf8 string compare).
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.svg  text eol=lf

# Preserve vendored manifest sizes and executable script line endings on Windows.
.agents/skills/agent-workflow/** text eol=lf
.claude/skills/agent-workflow/** text eol=lf
.claude/hooks/** text eol=lf
scripts/agent-workflow* text eol=lf
scripts/agent-redline* text eol=lf
scripts/format-verdict-comment.py text eol=lf
.github/workflows/agent-workflow.yml text eol=lf
